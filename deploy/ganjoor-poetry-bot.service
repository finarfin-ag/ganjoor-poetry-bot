[Unit]
Description=Ganjoor Poetry Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ganjoorbot
Group=ganjoorbot
WorkingDirectory=/opt/ganjoor-poetry-bot
EnvironmentFile=/etc/ganjoor-poetry-bot.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ganjoor-poetry-bot/.venv/bin/python -m ganjoor_bot.telegram_bot
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
StateDirectory=ganjoor-poetry-bot
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
